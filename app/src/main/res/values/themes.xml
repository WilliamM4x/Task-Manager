<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Profile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A6C92</item>
        <item name="colorPrimaryVariant">#297495</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">#04A8BD</item>
        <item name="colorSecondaryVariant">#2D99EF</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>

    <style name="Theme.Profile" parent="Base.Theme.Profile" />

    <style name="login_layout_input">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:color">#673AB7</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_centerHorizontal"></item>

    </style>

    <style name="password_layout_input">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:color">#673AB7</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_centerHorizontal"></item>
    </style>

    <style name="btn_entry">
        <item name="colorButtonNormal">#1A6C92</item>
        <item name="backgroundTint">#04A8BD</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_margin">16dp</item>

    </style>
</resources>