<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.devmax.fragments.WeatherFragment">

    <LinearLayout
        android:padding="20dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageWather"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="left"/>

            <LinearLayout
            android:gravity="left"
            android:id="@+id/layoutTxtWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
                <TextView
                    android:id="@+id/textWTemperaure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColorLink="@color/black"
                    android:shadowColor="@color/black"
                    android:text="@string/loding"
                />
                <TextView
                    android:id="@+id/textWLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                />
                <TextView
                    android:id="@+id/textWcountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                   />
            </LinearLayout>

    </LinearLayout>
</FrameLayout>